PORT=3020

# MySQL holding the `grantiliff` database.
# Running in docker? docker-compose.yml overrides DB_HOST to host.docker.internal.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=intranet
DB_PASSWORD=change-me
DB_NAME=grantiliff

# Signs the session cookie. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=change-me
SESSION_TTL_HOURS=12

# Set to true when served over https behind a proxy.
COOKIE_SECURE=false
