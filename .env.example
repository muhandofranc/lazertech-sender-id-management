PORT=3020

# Interface to bind. Behind a reverse proxy (Apache/nginx) set this to
# 127.0.0.1 so the dashboard is only reachable through the proxy -- otherwise
# it is served on every interface and clients can bypass the proxy by hitting
# the port directly.
BIND_HOST=0.0.0.0

# MySQL holding the `grantiliff` database.
#
# DB_HOST is read from this file only -- docker-compose.yml deliberately does
# not override it. Pick the one that matches the deployment:
#
#   production                  DB_HOST=172.16.1.2          DB_PORT=3130
#   MySQL on the docker host    DB_HOST=host.docker.internal
#   app run directly on the host DB_HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=intranet
DB_PASSWORD=change-me
DB_NAME=grantiliff

# Signs the session cookie. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=change-me
SESSION_TTL_HOURS=12

# Set to true when served over https behind a proxy.
COOKIE_SECURE=false
